{% extends "_base.j2" %}

{% block title %}Revenue Leak Audit — {{ prospect_domain }} — Titan Leap{% endblock %}

{% block extra_css %}
  /* ── AUDIT-SPECIFIC ──────────────────────────────────────────────────── */

  /* HEADER */
  header{
    padding:64px 0 0;
    background:
      radial-gradient(120% 80% at 80% -10%, rgba(107,33,232,.28), transparent 60%),
      var(--bg-deep);
    border-bottom:1px solid var(--line);
  }
  h1{font-size:clamp(34px,7vw,52px);font-weight:800;line-height:1.04;letter-spacing:-.02em;margin-bottom:14px}
  .sub{color:var(--ink-dim);font-size:16px;max-width:50ch;margin-bottom:36px}
  .meta-row{display:flex;flex-wrap:wrap;gap:0;border-top:1px solid var(--line);margin-top:8px}
  .meta{flex:1;min-width:140px;padding:18px 20px 22px 0;border-right:1px solid var(--line)}
  .meta:last-child{border-right:none;padding-right:0}
  .meta .k{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:7px}
  .meta .v{font-size:15px;font-weight:600}
  .meta .v.flag{color:var(--gold)}

  /* THE UNCOMFORTABLE TRUTH */
  .truth{margin:0;padding:44px 0;background:var(--bg);border-bottom:1px solid var(--line)}
  .truth-card{
    border:1px solid var(--line-bright);border-left:3px solid var(--gold);
    background:linear-gradient(180deg,var(--card-hi),var(--card));
    padding:30px 32px;border-radius:4px;
  }
  .truth-card .lbl{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:14px}
  .truth-card p{font-size:21px;line-height:1.45;font-weight:600;letter-spacing:-.01em}
  .truth-card .by{margin-top:18px;font-size:13px;color:var(--ink-dim)}

  /* LEAKS SECTION */
  section{padding:52px 0;border-bottom:1px solid var(--line);background:var(--bg-deep)}
  .sec-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:6px}
  .sec-title{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-faint)}
  .sec-sum{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--gold);font-weight:600}
  .sec-lead{font-size:15px;color:var(--ink-dim);margin-bottom:34px;max-width:54ch}

  /* LEAK CARDS */
  .leak{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:0;margin-bottom:20px;overflow:hidden}
  .leak-top{display:flex;gap:18px;align-items:flex-start;padding:24px 26px 20px}
  .leak-no{
    font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;color:var(--purple);
    border:1px solid var(--line-bright);border-radius:6px;
    width:40px;height:40px;display:flex;align-items:center;justify-content:center;
    flex-shrink:0;background:var(--bg-deep);
  }
  .leak-h{flex:1}
  .leak-h h3{font-size:20px;font-weight:700;letter-spacing:-.01em;margin-bottom:6px}
  .leak-h .where{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink-faint)}
  .sev{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;padding:5px 9px;border-radius:4px;flex-shrink:0;font-weight:600}
  .sev.high{background:rgba(255,90,90,.12);color:var(--danger);border:1px solid rgba(255,90,90,.3)}
  .sev.med{background:rgba(245,197,24,.1);color:var(--gold);border:1px solid rgba(245,197,24,.28)}

  .leak-body{padding:0 26px 8px}
  .leak-body p{font-size:15px;color:var(--ink-dim);margin-bottom:18px;max-width:58ch}
  .leak-body p strong{color:var(--ink);font-weight:600}

  /* COST BOX */
  .cost{display:flex;align-items:stretch;gap:0;border:1px solid var(--line-bright);border-radius:6px;margin:4px 0 20px;overflow:hidden}
  .cost-fig{padding:18px 22px;background:var(--bg-deep);border-right:1px solid var(--line-bright)}
  .cost-fig .k{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:6px}
  .cost-fig .v{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:700;color:var(--danger);letter-spacing:-.01em}
  .cost-note{padding:18px 22px;font-size:13px;color:var(--ink-faint);display:flex;align-items:center;flex:1}

  /* FIX FOOTER */
  .fix{border-top:1px solid var(--line);padding:18px 26px 24px;display:flex;gap:14px;align-items:flex-start;background:linear-gradient(180deg,transparent,rgba(107,33,232,.05))}
  .fix .tag{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--purple);font-weight:700;padding-top:2px;flex-shrink:0}
  .fix p{font-size:14px;color:var(--ink);margin:0}
  .fix .eff{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-faint);margin-top:6px}

  /* TOTAL */
  .total{background:var(--bg);text-align:center;padding:48px 0}
  .total .k{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-dim);margin-bottom:14px}
  .total .v{font-family:'JetBrains Mono',monospace;font-size:clamp(34px,8vw,52px);font-weight:800;color:var(--gold);letter-spacing:-.02em}
  .total .cap{font-size:14px;color:var(--ink-faint);margin-top:14px;max-width:46ch;margin-left:auto;margin-right:auto}

  /* THIS WEEK'S MOVES */
  .week-item{display:flex;gap:18px;align-items:flex-start;padding:20px 0;border-top:1px solid var(--line)}
  .week-item:first-of-type{border-top:none}
  .week-no{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--gold);font-weight:700;flex-shrink:0;padding-top:1px}
  .week-c h4{font-size:16px;font-weight:600;margin-bottom:4px}
  .week-c p{font-size:14px;color:var(--ink-dim)}
  .week-c .t{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-faint);margin-top:6px}

  /* CTA */
  .cta{
    background:radial-gradient(120% 100% at 50% 0%, rgba(107,33,232,.3), transparent 65%),var(--bg-deep);
    text-align:center;padding:60px 0 70px;
  }
  .cta h2{font-size:clamp(26px,5vw,34px);font-weight:800;letter-spacing:-.02em;margin-bottom:14px}
  .cta p{color:var(--ink-dim);font-size:16px;max-width:48ch;margin:0 auto 30px}
  .cta .fine{margin-top:18px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink-faint)}

  @media (max-width:560px){
    .cost{flex-direction:column}
    .cost-fig{border-right:none;border-bottom:1px solid var(--line-bright)}
    .meta{min-width:50%;flex:0 0 50%;border-right:none}
    .leak-top{flex-wrap:wrap}
  }
{% endblock %}

{% block content %}
<header>
  <div class="wrap">
    <div class="eyebrow">Revenue Leak Audit</div>
    <h1>{{ uncomfortable_truth_headline }}</h1>
    <p class="sub">A focused teardown of where revenue is escaping your funnel — and what each leak is worth if you fix it.</p>
    <div class="meta-row">
      <div class="meta"><div class="k">Prepared for</div><div class="v">{{ prospect_domain }}</div></div>
      <div class="meta"><div class="k">Date</div><div class="v">{{ audit_date }}</div></div>
      <div class="meta"><div class="k">Pages reviewed</div><div class="v">{{ pages_reviewed }}</div></div>
      <div class="meta"><div class="k">Leaks found</div><div class="v flag">{{ leak_count }} critical</div></div>
    </div>
  </div>
</header>

<div class="truth">
  <div class="wrap">
    <div class="truth-card">
      <div class="lbl">The uncomfortable truth</div>
      <p>{{ uncomfortable_truth }}</p>
      <div class="by">{{ truth_subtext }}</div>
    </div>
  </div>
</div>

<section>
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-title">The Leaks</div>
      <div class="sec-sum">{{ leak_count }} found · ranked by $ impact</div>
    </div>
    <p class="sec-lead">No fluff, no 12-point checklist dump. Here are the {{ leak_count }} things actually bleeding revenue, biggest first.</p>

    {% for leak in leaks %}
    <div class="leak">
      <div class="leak-top">
        <div class="leak-no">{{ '%02d' % leak.rank }}</div>
        <div class="leak-h">
          <h3>{{ leak.title }}</h3>
          <div class="where">{{ leak.location }}</div>
        </div>
        <div class="sev {{ leak.severity }}">{{ leak.severity | title }}</div>
      </div>
      <div class="leak-body">
        <p>{{ leak.description | safe }}</p>
        <div class="cost">
          <div class="cost-fig">
            <div class="k">Est. monthly loss</div>
            <div class="v">${{ '{:,}'.format(leak.monthly_loss_low) }}–${{ '{:,}'.format(leak.monthly_loss_high) }}</div>
          </div>
          <div class="cost-note">{{ leak.cost_assumptions }}</div>
        </div>
      </div>
      <div class="fix">
        <div class="tag">Fix</div>
        <div>
          <p>{{ leak.fix_text | safe }}</p>
          <div class="eff">{{ leak.fix_effort }} · {{ leak.fix_timing }}</div>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<div class="total">
  <div class="wrap">
    <div class="k">Total estimated monthly leak</div>
    <div class="v">{{ total_low }} – {{ total_high }}</div>
    <div class="cap">{{ total_caption }}</div>
  </div>
</div>

<section>
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-title">This Week's Moves</div>
      <div class="sec-sum">in order</div>
    </div>
    <p class="sec-lead">Do them top to bottom. Each one maps to a leak above. Highest-dollar fix first.</p>

    {% for move in week_moves %}
    <div class="week-item">
      <div class="week-no">{{ '%02d' % move.rank }}</div>
      <div class="week-c">
        <h4>{{ move.title }}</h4>
        <p>{{ move.body | safe }}</p>
        <div class="t">{{ move.recovers_leak }} · {{ move.effort }}</div>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<div class="cta">
  <div class="wrap">
    <h2>{{ cta_headline }}</h2>
    <p>{{ cta_body }}</p>
    <a href="{{ cta_url }}" class="btn">Book the Growth System Sprint</a>
    <div class="fine">Or reply to this report — we read every one.</div>
  </div>
</div>
{% endblock %}
