{% extends "_base.j2" %}

{% block title %}Your First 90 Days — {{ prospect_domain }} — Titan Leap{% endblock %}

{% block extra_css %}
  /* ── ROADMAP-SPECIFIC ────────────────────────────────────────────────── */

  /* 780px wrap for roadmap (vs 760px default) */
  .wrap{max-width:780px}
  .eyebrow{margin-bottom:24px}  /* roadmap uses 24px vs base 22px */

  /* HEADER */
  header{
    padding:72px 0 56px;
    background:
      radial-gradient(130% 90% at 75% -10%, rgba(107,33,232,.32), transparent 60%),
      var(--bg-deep);
    border-bottom:1px solid var(--line);
  }
  h1{font-size:clamp(36px,7.5vw,58px);font-weight:800;line-height:1.02;letter-spacing:-.025em;margin-bottom:18px}
  h1 .em{color:var(--purple-soft)}
  .lede{color:var(--ink-dim);font-size:17px;max-width:52ch;line-height:1.6}

  /* THESIS */
  .thesis{padding:44px 0;background:var(--bg);border-bottom:1px solid var(--line)}
  .thesis-card{
    border:1px solid var(--line-bright);border-left:3px solid var(--purple);
    background:linear-gradient(180deg,var(--card-hi),var(--card));
    padding:30px 32px;border-radius:4px;
  }
  .thesis-card .lbl{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--purple-soft);margin-bottom:14px}
  .thesis-card p{font-size:20px;line-height:1.5;font-weight:600;letter-spacing:-.01em}
  .thesis-card p .hl{color:var(--gold)}

  /* TIMELINE */
  .timeline{padding:56px 0 20px;background:var(--bg-deep)}
  .sec-head{margin-bottom:8px}
  .sec-title{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-faint)}
  .sec-lead{font-size:15px;color:var(--ink-dim);margin-bottom:44px;max-width:54ch}

  /* PHASES */
  .phase{position:relative;padding-left:42px;padding-bottom:48px}
  .phase::before{
    content:"";position:absolute;left:13px;top:8px;bottom:-8px;width:1px;
    background:linear-gradient(180deg,var(--line-bright),var(--line));
  }
  .phase:last-child::before{display:none}
  .phase-dot{
    position:absolute;left:0;top:2px;width:28px;height:28px;border-radius:50%;
    background:var(--bg-deep);border:1px solid var(--line-bright);
    display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;color:var(--purple-soft);
    z-index:2;
  }
  .phase-head{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:6px}
  .phase-days{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--gold);font-weight:600;letter-spacing:.04em}
  .phase-head h2{font-size:24px;font-weight:800;letter-spacing:-.02em}
  .phase-goal{font-size:15px;color:var(--ink-dim);margin-bottom:24px;max-width:56ch}
  .phase-goal strong{color:var(--ink);font-weight:600}

  /* WORK ITEMS */
  .work{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:6px 0}
  .work-item{display:flex;gap:16px;align-items:flex-start;padding:16px 24px;border-top:1px solid var(--line)}
  .work-item:first-child{border-top:none}
  .work-item .ic{
    width:22px;height:22px;border-radius:5px;flex-shrink:0;margin-top:1px;
    background:rgba(107,33,232,.14);border:1px solid var(--line-bright);
    display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--purple-soft);font-weight:700;
  }
  .work-item .wc h4{font-size:15px;font-weight:600;margin-bottom:3px}
  .work-item .wc p{font-size:13.5px;color:var(--ink-dim);line-height:1.5}

  /* MILESTONE */
  .milestone{
    margin-top:18px;display:flex;gap:12px;align-items:center;
    padding:14px 20px;border-radius:8px;
    background:linear-gradient(90deg,rgba(74,222,128,.08),transparent);
    border:1px solid rgba(74,222,128,.22);
  }
  .milestone .flag{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--green);font-weight:700;flex-shrink:0}
  .milestone p{font-size:14px;color:var(--ink);font-weight:500}

  /* OUTCOME GRID */
  .outcome{padding:56px 0;background:var(--bg);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .outcome .sec-title{margin-bottom:8px}
  .outcome h3{font-size:clamp(24px,4.5vw,32px);font-weight:800;letter-spacing:-.02em;margin-bottom:30px;max-width:18ch}
  .outcome h3 .em{color:var(--gold)}
  .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
  .out-card{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:22px}
  .out-card .n{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:800;color:var(--purple-soft);letter-spacing:-.01em;margin-bottom:8px}
  .out-card h4{font-size:15px;font-weight:600;margin-bottom:5px}
  .out-card p{font-size:13px;color:var(--ink-dim);line-height:1.5}

  /* CTA */
  .cta{
    background:radial-gradient(130% 100% at 50% 0%, rgba(107,33,232,.32), transparent 65%),var(--bg-deep);
    text-align:center;padding:64px 0 72px;
  }
  .cta h2{font-size:clamp(28px,5.5vw,38px);font-weight:800;letter-spacing:-.02em;margin-bottom:14px}
  .cta p{color:var(--ink-dim);font-size:16px;max-width:50ch;margin:0 auto 32px}
  /* roadmap btn is slightly larger than base */
  .btn{padding:16px 36px}
  .cta .fine{margin-top:18px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink-faint)}
  .cta .alt{display:block;margin-top:10px;color:var(--purple-soft);font-size:13px;text-decoration:none}
  .cta .alt:hover{text-decoration:underline}

  /* footer wider on roadmap */
  footer .dis{max-width:54ch}

  @media (max-width:560px){
    .grid{grid-template-columns:1fr}
    .phase{padding-left:36px}
  }
{% endblock %}

{% block content %}
<header>
  <div class="wrap">
    <div class="eyebrow">The 90-Day Growth System · {{ prospect_domain }}</div>
    <h1>What your first <span class="em">90 days</span> actually looks like.</h1>
    <p class="lede">{{ roadmap_lede }}</p>
  </div>
</header>

<div class="thesis">
  <div class="wrap">
    <div class="thesis-card">
      <div class="lbl">The operating principle</div>
      <p>{{ thesis | safe }}</p>
    </div>
  </div>
</div>

<div class="timeline">
  <div class="wrap">
    <div class="sec-head"><div class="sec-title">The Roadmap · 3 Phases</div></div>
    <p class="sec-lead">Three 30-day phases. Each one ends with something live and measurable — no 90-day "trust us" black box.</p>

    {% for phase in phases %}
    <div class="phase">
      <div class="phase-dot">{{ '%02d' % phase.number }}</div>
      <div class="phase-head">
        <span class="phase-days">{{ phase.day_range }}</span>
        <h2>{{ phase.title }}</h2>
      </div>
      <p class="phase-goal">{{ phase.goal | safe }}</p>
      <div class="work">
        {% for item in phase.work_items %}
        <div class="work-item">
          <div class="ic">{{ item.ic }}</div>
          <div class="wc">
            <h4>{{ item.title }}</h4>
            <p>{{ item.body }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
      <div class="milestone">
        <span class="flag">Day {{ phase.milestone_day }}</span>
        <p>{{ phase.milestone }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<div class="outcome">
  <div class="wrap">
    <div class="sec-title">By Day 90 You Own</div>
    <h3>A system, not a <span class="em">stack of invoices.</span></h3>
    <div class="grid">
      {% for card in outcome_cards %}
      <div class="out-card">
        <div class="n">{{ card.n }}</div>
        <h4>{{ card.title }}</h4>
        <p>{{ card.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="cta">
  <div class="wrap">
    <h2>{{ cta_headline }}</h2>
    <p>{{ cta_body }}</p>
    <a href="{{ cta_url }}" class="btn">{{ cta_btn }}</a>
    {% if cta_alt %}<a href="{{ cta_alt_url }}" class="alt">{{ cta_alt }} →</a>{% endif %}
    {% if cta_fine %}<div class="fine">{{ cta_fine }}</div>{% endif %}
  </div>
</div>
{% endblock %}
