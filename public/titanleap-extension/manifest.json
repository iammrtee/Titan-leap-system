{
  "manifest_version": 3,
  "name": "TitanLeap Local Executor",
  "version": "1.0",
  "description": "Locally executes TitanLeap social media posts to bypass bot detection.",
  "permissions": ["tabs", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "TitanLeap Executor Active",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
